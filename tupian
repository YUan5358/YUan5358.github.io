<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>图片展示</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        
        :root {
            --bg-color: #f0f0f0;
            --text-color: #333;
            --card-bg: #ffffff;
            --shadow-color: rgba(0, 0, 0, 0.15);
        }
        
        [data-theme="dark"] {
            --bg-color: #121212;
            --text-color: #e0e0e0;
            --card-bg: #1e1e1e;
            --shadow-color: rgba(0, 0, 0, 0.4);
        }
        
        body {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 20px;
            min-height: 100vh;
            background-color: var(--bg-color);
            padding: 20px;
            color: var(--text-color);
        }
        
        .back-button {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 100;
            background-color: var(--card-bg);
            color: var(--text-color);
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 2px 8px var(--shadow-color);
            text-decoration: none;
        }
        
        .back-button:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 12px var(--shadow-color);
        }
        
        .theme-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 100;
            background-color: var(--card-bg);
            color: var(--text-color);
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 2px 8px var(--shadow-color);
        }
        
        .theme-toggle:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 12px var(--shadow-color);
        }
        
        img {
            max-width: 100%;
            height: auto;
            display: block;
            border-radius: 8px;
            box-shadow: 0 4px 12px var(--shadow-color);
            background-color: var(--card-bg);
        }
        
        @media (min-width: 768px) {
            body {
                gap: 40px;
            }
        }
        
        @media (max-width: 600px) {
            .back-button, .theme-toggle {
                width: 40px;
                height: 40px;
                font-size: 16px;
            }
            
            body {
                gap: 15px;
                padding: 15px;
                padding-top: 70px;
            }
            
            img {
                max-width: 90%;
            }
        }
        
        @media (max-width: 400px) {
            .back-button, .theme-toggle {
                width: 35px;
                height: 35px;
                font-size: 14px;
                top: 15px;
            }
            
            .back-button {
                left: 15px;
            }
            
            .theme-toggle {
                right: 15px;
            }
            
            body {
                gap: 10px;
                padding: 10px;
                padding-top: 60px;
            }
        }
    </style>
</head>
<body>
    <a href="https://yuan5358.github.io" class="back-button">
        ←
    </a>
    
    <button class="theme-toggle" id="themeToggle">
        🌓
    </button>
    
    <img src="https://s41.ax1x.com/2026/04/03/peYuA3j.jpg" alt="图片1">
    <img src="https://s41.ax1x.com/2026/02/18/pZOI2M4.jpg" alt="图片2">
    <img src="https://s41.ax1x.com/2026/02/22/pZjgO6s.jpg" alt="图片3">
    <img src="https://s41.ax1x.com/2026/04/03/peYnzut.jpg" alt="图片4">

    <script>
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;
        
        const savedTheme = localStorage.getItem('theme') || 'light';
        if (savedTheme === 'dark') {
            html.setAttribute('data-theme', 'dark');
            themeToggle.textContent = '☀️';
        } else {
            themeToggle.textContent = '🌙';
        }
        
        themeToggle.addEventListener('click', () => {
            const currentTheme = html.getAttribute('data-theme');
            
            if (currentTheme === 'dark') {
                html.removeAttribute('data-theme');
                themeToggle.textContent = '🌙';
                localStorage.setItem('theme', 'light');
            } else {
                html.setAttribute('data-theme', 'dark');
                themeToggle.textContent = '☀️';
                localStorage.setItem('theme', 'dark');
            }
        });
        
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
        
        if (!localStorage.getItem('theme')) {
            if (prefersDark.matches) {
                html.setAttribute('data-theme', 'dark');
                themeToggle.textContent = '☀️';
            }
        }
        
        prefersDark.addEventListener('change', (e) => {
            if (!localStorage.getItem('theme')) {
                if (e.matches) {
                    html.setAttribute('data-theme', 'dark');
                    themeToggle.textContent = '☀️';
                } else {
                    html.removeAttribute('data-theme');
                    themeToggle.textContent = '🌙';
                }
            }
        });
    </script>
</body>
</html>
